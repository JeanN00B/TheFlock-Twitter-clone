POSTGRES_USER=flock # postgres user
POSTGRES_PASSWORD=flockpw # change me
POSTGRES_DB=flockdb # postgres database
DATABASE_URL=postgresql+psycopg://flock:flockpw@twitter-db:5432/flockdb # backend db url
TWITTER_DB_PORT=5433 # host port for postgres
TWITTER_BACKEND_PORT=8000 # host port for backend
TWITTER_FRONTEND_PORT=3000 # host port for frontend
BACKEND_API_URL=http://twitter-backend:8000 # server-only backend url inside docker
BACKEND_SECRET_KEY=your_secret_key # backend secret key
NEXT_PUBLIC_API_URL=http://localhost:8000 # browser backend url (baked at build)
NODE_ENV=production # node env


TEST_DATABASE_URL=postgresql+psycopg://flock:flockpw@twitter-db:5433/flockdb # test db url
AUTO_MIGRATE=false # false by default (prod-safe), set true in dev overlay
