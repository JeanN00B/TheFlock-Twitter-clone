# Postgres
POSTGRES_USER=flock
POSTGRES_PASSWORD=flockpw
POSTGRES_DB=flockdb
# In-compose backend → twitter-db (container port 5432)
DATABASE_URL=postgresql+psycopg://flock:flockpw@twitter-db:5432/flockdb

# Host-published ports
TWITTER_DB_PORT=5433
TWITTER_BACKEND_PORT=8000
TWITTER_FRONTEND_PORT=3000

# Backend
BACKEND_API_URL=http://twitter-backend:8000
BACKEND_SECRET_KEY=your_secret_key
# development | production — drives session cookie Secure flag
APP_ENVIRONMENT=development
# false by default (prod-safe); docker-compose.dev.yml defaults AUTO_MIGRATE=true
AUTO_MIGRATE=false

# Frontend (NEXT_PUBLIC_* are baked at image/build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# Pytest integration DB — host port for twitter-testing-db (compose profile "test")
TEST_DATABASE_URL=postgresql+psycopg://flock:flockpw@localhost:5434/flockdb
