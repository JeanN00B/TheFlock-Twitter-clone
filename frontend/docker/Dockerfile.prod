# syntax=docker/dockerfile:1
# theFlock-twitter frontend prod — Next 16.3.4 / React 19 / pnpm 10.32.1 on Node 24-alpine.
# Standalone file (no targets). Expects `output: 'standalone'` in next.config.ts.

FROM node:24-alpine AS deps
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# Builder: NEXT_PUBLIC_* vars bake in at build time — pass via --build-arg.
FROM node:24-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL

ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml next.config.ts tsconfig.json postcss.config.mjs ./
COPY src ./src
COPY public ./public
RUN pnpm build

# Runner: standalone server as non-root nextjs.
FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache netcat-openbsd
RUN addgroup -S nextjs && adduser -S nextjs -G nextjs
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nextjs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
ENTRYPOINT ["entrypoint.sh"]
CMD ["node", "server.js"]
